{
  "unsplash": {
    "endpoint_url": "https://api.unsplash.com/photos/random",
    "domains": ["api.unsplash.com"],
    "auth_type": "param",
    "key_param": "client_id",
    "api_key": "",
    "query_param": "query",
    "orientation_param": "orientation",
    "extra_params": {
      "color": "black_and_white"
    },
    "json_path": "urls.regular"
  },
  "pixabay": {
    "endpoint_url": "https://pixabay.com/api/",
    "domains": ["pixabay.com"],
    "auth_type": "param",
    "key_param": "key",
    "api_key": "",
    "query_param": "q",
    "orientation_param": "orientation",
    "orientation_map": {
      "landscape": "horizontal",
      "portrait": "vertical"
    },
    "extra_params": {
      "image_type": "photo",
      "colors": "grayscale",
      "per_page": 20
    },
    "json_path": "hits.0.largeImageURL",
    "randomize_list": "hits"
  },
  "pexels": {
    "endpoint_url": "https://api.pexels.com/v1/search",
    "domains": ["api.pexels.com"],
    "auth_type": "header",
    "header_name": "Authorization",
    "api_key": "",
    "query_param": "query",
    "orientation_param": "orientation",
    "extra_params": {
      "per_page": 15
    },
    "json_path": "photos.0.src.large",
    "randomize_list": "photos"
  },
  "artic": {
    "endpoint_url": "https://api.artic.edu/api/v1/artworks/search",
    "domains": ["artic.edu"],
    "auth_type": "none",
    "query_param": "q",
    "extra_params": {
      "fields": "id,title,image_id",
      "limit": 15
    },
    "json_path": "data.0.image_id",
    "randomize_list": "data",
    "url_template": "https://www.artic.edu/iiif/2/{value}/full/800,/0/default.jpg"
  },
  "giphy": {
    "endpoint_url": "https://api.giphy.com/v1/gifs/random",
    "domains": ["api.giphy.com"],
    "auth_type": "param",
    "key_param": "api_key",
    "api_key": "",
    "query_param": "tag",
    "json_path": "data.images.downsized_still.url"
  }
}
